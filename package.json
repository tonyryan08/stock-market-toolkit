{
  "name": "stock-market-toolkit",
  "version": "0.13.0",
  "private": true,
  "description": "Course toolkit for 'Intro to the Stock Market' — a community-school course in good financial decision-making. Education, not advice.",
  "scripts": {
    "dev": "wrangler dev",
    "dev:cron": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit",
    "verify-universe": "node scripts/verify-universe.mjs",
    "seed-small-caps": "node scripts/seed-small-caps.mjs",
    "smallcaps": "node scripts/visit-small-caps.mjs",
    "enrol": "node scripts/enrol.mjs",
    "seed-notes": "node scripts/seed-notes.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "4.13.18"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wrangler": "4.160.0"
  },
  "engines": {
    "node": ">=20"
  }
}
